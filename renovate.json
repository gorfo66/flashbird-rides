{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "groupName": "Angular and related packages",
      "automerge": false,
      "matchPackageNames": [
        "/^@angular\\//",
        "/^angular-eslint/",
        "/^@ngrx\\//"
      ]
    },
    {
      "groupName": "Angular and related packages",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "matchPackageNames": [
        "/^@angular\\//",
        "/^angular-eslint/",
        "/^@ngrx\\//"
      ]
    }
  ],
  "npm": {},
  "schedule": [
    "at any time"
  ],
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "semanticCommitScope": "deps",
  "prConcurrentLimit": 5,
  "rebaseWhen": "behind-base-branch",
  "prCreation": "immediate",
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
